APP_ENV=development
API_V1_PREFIX=/api/v1
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=smart_exam_ethiopia
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_ORIGIN=http://localhost:3000

# First Admin bootstrap only. Keep backend/.env private and never commit it.
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=System Administrator
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
